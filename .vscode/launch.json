{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GSX VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode/gsx"
      ],
      "outFiles": [
        "${workspaceFolder}/editors/vscode/gsx/dist/**/*.js"
      ],
      "preLaunchTask": "gsx-extension: compile"
    }
  ]
}
